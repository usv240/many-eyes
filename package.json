{
  "name": "many-eyes",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "server",
    "overlay",
    "sim"
  ],
  "scripts": {
    "dev": "npm run demo",
    "demo": "node --env-file=.env --import tsx scripts/broadcast.ts sim",
    "demo:video": "node --env-file=.env --import tsx scripts/broadcast.ts video",
    "report": "tsx scripts/mission-report.ts",
    "live": "node --env-file=.env --import tsx scripts/broadcast.ts twitch",
    "demo:mixed": "node --env-file=.env --import tsx scripts/broadcast.ts mixed",
    "dev:server": "node --env-file=.env --watch --import tsx server/src/index.ts",
    "dev:bot": "node --env-file=.env --import tsx server/src/bot.ts",
    "test": "vitest run",
    "lint": "eslint . && tsc --noEmit -p tsconfig.json",
    "tiles:warm": "tsx scripts/warm-tiles.ts",
    "bench": "tsx scripts/bench.ts",
    "mission": "node --env-file=.env --import tsx scripts/run-mission.ts",
    "verify": "tsx server/src/verify.ts",
    "debates:warm": "node --env-file=.env --import tsx scripts/warm-debates.ts",
    "debates:score": "tsx scripts/score-debates.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^6.4.1",
    "vitest": "^3.2.4"
  }
}
