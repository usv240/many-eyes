{
  "name": "many-eyes",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "server",
    "overlay",
    "sim"
  ],
  "scripts": {
    "dev": "node --env-file=.env --import tsx scripts/dev.ts",
    "dev:bot": "node --env-file=.env --import tsx server/src/bot.ts",
    "test": "vitest run",
    "lint": "eslint . && tsc --noEmit -p tsconfig.json",
    "tiles:warm": "tsx scripts/warm-tiles.ts",
    "verify": "tsx server/src/verify.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^6.4.1",
    "vitest": "^3.2.4"
  }
}
